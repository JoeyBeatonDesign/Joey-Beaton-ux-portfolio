---
// Figma: Home page - Desktop / Mobile
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/portrait-home.png';
---
<Base
  title="Joey Beaton – UX & Product Designer"
  description="UX and product designer Joey Beaton. Case studies in accessibility, user research and app design, taking ideas from research to tested, accessible solutions."
  current="home"
>
  <section class="hero container">
    <div class="hero__text">
      <p class="hero__intro t-body-intro">I’m a user-centred designer prioritising empathy, testing and accessibility over assumptions</p>
      <h1 class="hero__name t-display-hero">Joey<br />Beaton</h1>
    </div>
    <div class="hero__portrait">
      <Image src={portrait} alt="Black-and-white portrait of Joey Beaton smiling." widths={[400, 600, 800, 1200]} sizes="(min-width: 768px) 600px, 100vw" format="webp" loading="eager" />
    </div>
  </section>
</Base>

<style>
  /* Mobile and Tablet: text first, then the portrait (Medium image, 4:5, up to layout/hero-image-width) */
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--layout-block-gap);
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--layout-block-gap);
  }
  .hero__intro {
    max-width: var(--layout-hero-text-width);
    color: var(--colour-text-body);
  }
  .hero__name {
    color: var(--colour-text-heading);
  }
  .hero__portrait {
    width: 100%;
    max-width: var(--layout-hero-image-width);
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-image);
    background: var(--colour-bg-image-accent);
    overflow: hidden;
  }
  .hero__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Desktop: a fluid hero (Figma: "Home page - Desktop – fluid preview" frames).
     The photo is as tall as the screen minus the nav, with layout/block-gap above and below,
     kept between layout/hero-image-min-width and layout/hero-image-width wide (4:5).
     The name grows with the photo from type/size/display/hero to type/size/display/hero-max,
     and never wider than its column. Photo left, gap space/64, text right. */
  @media (min-width: 1280px) {
    .hero {
      --nav-h: calc(var(--layout-control-size) + 2 * var(--layout-card-padding));
      --photo-h: clamp(
        calc(var(--layout-hero-image-min-width) * 5 / 4),
        calc(100svh - var(--nav-h) - 2 * var(--layout-block-gap)),
        calc(var(--layout-hero-image-width) * 5 / 4)
      );
      flex-direction: row-reverse;
      justify-content: flex-start;
      align-items: flex-start;
      gap: var(--space-64);
      padding-inline: var(--layout-section);
    }
    .hero__portrait {
      flex: none;
      width: calc(var(--photo-h) * 4 / 5);
      height: var(--photo-h);
    }
    .hero__text {
      flex: 1 1 0;
      min-width: 0;
      container-type: inline-size;
      padding-bottom: var(--layout-tight);
    }
    .hero__name {
      text-align: right;
      /* 144/550: the name keeps its Figma proportion to the photo. 3.25: "BEATON" is about 3.2 × the font size wide. */
      font-size: clamp(
        var(--type-size-display-hero),
        min(var(--photo-h) * 144 / 550, 100cqi / 3.25),
        var(--type-size-display-hero-max)
      );
    }
  }
</style>
