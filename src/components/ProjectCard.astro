---
// Figma: Project card (State Default / Hover / Focus, Layout Image left / right, Breakpoint Desktop / Mobile).
// Hover: overlay (colour/overlay/card) and a green CLICK badge on the image, 200ms ease-out.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  number: string;
  title: string;
  meta: string;
  image: ImageMetadata;
  alt: string;
  layout?: 'image-left' | 'image-right';
  class?: string;
}
const { href, number, title, meta, image, alt, layout = 'image-right', class: className } = Astro.props;
---
<a href={href} class:list={['card', `card--${layout}`, className]}>
  <div class="card__text">
    <p class="card__number t-label" aria-hidden="true">{number}</p>
    <h2 class="card__title t-heading-item">{title}</h2>
    <p class="card__meta t-label">{meta}</p>
  </div>
  <div class="card__image">
    <Image src={image} alt={alt} widths={[360, 720]} sizes="(min-width: 1280px) 360px, 100vw" format="webp" />
    <span class="card__overlay" aria-hidden="true"></span>
    <span class="card__badge t-label" aria-hidden="true">Click</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--layout-image-text);
  }
  .card__text {
    display: flex;
    flex-direction: column;
    gap: var(--layout-stack);
  }
  .card__number,
  .card__meta {
    color: var(--colour-text-body);
  }
  .card__title {
    color: var(--colour-text-heading);
  }
  .card__image {
    position: relative;
    aspect-ratio: 360 / 450;
    background: var(--colour-image-bg);
    overflow: hidden;
  }
  .card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .card__overlay,
  .card__badge {
    position: absolute;
    opacity: 0;
    transition: opacity 200ms ease-out;
  }
  .card__overlay {
    inset: 0;
    background: var(--colour-overlay-card);
  }
  .card__badge {
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: var(--layout-badge-size);
    height: var(--layout-badge-size);
    margin: calc(var(--layout-badge-size) / -2) 0 0 calc(var(--layout-badge-size) / -2);
    border-radius: var(--radius-button);
    background: var(--colour-action-bg);
    color: var(--colour-action-text);
  }
  .card:hover .card__overlay,
  .card:hover .card__badge {
    opacity: 1;
  }

  /* Desktop: side by side, aligned to the bottom; image is layout/card-image-width wide */
  @media (min-width: 1280px) {
    .card {
      flex-direction: row;
      align-items: flex-end;
    }
    .card--image-left {
      flex-direction: row-reverse;
      justify-content: flex-end;
    }
    .card__text {
      flex: 1;
    }
    .card__image {
      flex: none;
      width: var(--layout-card-image-width);
    }
  }
</style>
