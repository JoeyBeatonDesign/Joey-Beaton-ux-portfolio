---
// Figma: Theme toggle (Default, Hover, Focus). Moon shows in Light, Sun in Dark.
// Behaviour (handoff note): follow the device on first visit, Light if none; remember the visitor's choice.
import Icon from './Icon.astro';
---
<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme">
  <Icon name="moon" class="theme-toggle__moon" />
  <Icon name="sun" class="theme-toggle__sun" />
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--layout-control-size);
    height: var(--layout-control-size);
    padding: 0;
    border: var(--border-default) solid var(--colour-action-outline);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--colour-action-outline);
    cursor: pointer;
    transition: background-color 150ms ease-out, color 150ms ease-out;
  }
  .theme-toggle:hover {
    background: var(--colour-action-bg-hover);
    color: var(--colour-action-text);
  }
  .theme-toggle :global(.theme-toggle__sun) { display: none; }
  :global([data-theme="dark"]) .theme-toggle :global(.theme-toggle__moon) { display: none; }
  :global([data-theme="dark"]) .theme-toggle :global(.theme-toggle__sun) { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .theme-toggle :global(.theme-toggle__moon) { display: none; }
    :global(:root:not([data-theme])) .theme-toggle :global(.theme-toggle__sun) { display: block; }
  }
</style>

<script>
  const current = () =>
    document.documentElement.dataset.theme ||
    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

  const label = () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-label', `Switch to ${next} theme`));
  };

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      label();
    });
  });
  label();
</script>
