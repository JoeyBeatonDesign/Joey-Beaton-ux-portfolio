---
// Small line icons for the live Library screens. Drawn as SVG (not text symbols like ↩ or ♥),
// so phones never swap them for colour emoji. They take the text colour and size of their parent (1em).
interface Props { name: 'undo' | 'cross' | 'heart' | 'heart-filled' | 'refresh' | 'back' }
const { name } = Astro.props;
---
<svg class="lib-icon" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'undo' && <path d="M9 14 4 9l5-5M4 9h10.5a5.5 5.5 0 0 1 0 11H11" />}
  {name === 'cross' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'heart' && <path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.6 4.5 7 4.5c2 0 3.6 1.2 5 3 1.4-1.8 3-3 5-3 3.4 0 5.6 3.5 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2Z" />}
  {name === 'heart-filled' && <path fill="currentColor" d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.6 4.5 7 4.5c2 0 3.6 1.2 5 3 1.4-1.8 3-3 5-3 3.4 0 5.6 3.5 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2Z" />}
  {name === 'refresh' && <path d="M3.5 12a8.5 8.5 0 1 0 2.5-6M6 2.5V6.5h4" />}
  {name === 'back' && <path d="M20 12H4m6-6-6 6 6 6" />}
</svg>

<style>
  .lib-icon { display: inline-block; flex: none; vertical-align: -0.125em; }
</style>
