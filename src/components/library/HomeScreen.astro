---
// Live rebuild of "Home page – personalized": four shelves that scroll sideways (mouse, touch or keyboard).
// The Tune icon would open preferences in the real app, so it shows a note instead.
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import './app.css';

const shelves: { h: string; books: [string, string, string][] }[] = [
  { h: 'Because you liked Project Hail Mary', books: [['The Martian', 'Andy Weir', '#cc482b'], ['Blindsight', 'Peter Watts', '#ae6209'], ['A Memory Called Empire', 'Arkady Martine', '#257cad'], ['Flowers for Algernon', 'Daniel Keyes', '#a34ad9'], ['The Dispossessed', 'Ursula K. Le Guin', '#1c854d']] },
  { h: 'Fantasy - because you like The Hobbit', books: [['The Goblin Emperor', 'Katherine Addison', '#cc482b'], ['Jonathan Strange', 'Susanna Clarke', '#ae6209'], ['Stardust', 'Neil Gaiman', '#a34ad9'], ['Uprooted', 'Naomi Novik', '#1c854d'], ['The Buried Giant', 'Kazuo Ishiguro', '#257cad']] },
  { h: 'Mystery - because you liked Big Magic', books: [['The Secret History', 'Donna Tartt', '#cc482b'], ['A Fatal Grace', 'Louise Penny', '#a34ad9'], ['Rebecca', 'Daphne du Maurier', '#257cad'], ['In the Woods', 'Tana French', '#1c854d'], ['The Little Stranger', 'Sarah Waters', '#ae6209']] },
  { h: 'Popular right now — for a fresh read', books: [['Intermezzo', 'Sally Rooney', '#a34ad9'], ['The Women', 'Kristin Hannah', '#cc482b'], ['James', 'Percival Everett', '#ae6209'], ['All Fours', 'Miranda July', '#1c854d'], ['Orbital', 'Samantha Harvey', '#257cad']] },
];
---
<div class="libapp hs-frame" data-home>
<div class="hs" tabindex="0" role="region" aria-label="Home page, scrolls up and down">
  <div class="hs__top">
    <p class="hs__app">Library</p>
    <button type="button" class="hs__tune" aria-label="Tune your recommendations" data-note-text="Next step: tune your recommendations, shown further down the page.">
      <svg width="16" height="14" viewBox="0 0 16 14" aria-hidden="true"><path d="M1 2h14M1 7h14M1 12h14" stroke="#6a6a6e" stroke-width="2" stroke-linecap="round" /><circle cx="11" cy="2" r="2.5" fill="#1a1a1e" /><circle cx="5" cy="7" r="2.5" fill="#1a1a1e" /><circle cx="10" cy="12" r="2.5" fill="#1a1a1e" /></svg>
    </button>
    <span class="hs__avatar" aria-hidden="true"></span>
  </div>
  <p class="hs__tip" aria-hidden="true">Tune your recommendations</p>

  <h3 class="libapp__heading hs__title">Start Reading</h3>
  {shelves.map((s, i) => (
    <section class="hs__shelf" aria-labelledby={`shelf-${i}`}>
      <h4 class="hs__shelf-h" id={`shelf-${i}`}>{s.h}</h4>
      <ul class="hs__row" tabindex="0" aria-label={`${s.h}, scrolls sideways`}>
        {s.books.map(([t, a, c]) => (
          <li class="hs__book">
            <span class="hs__cover" style={`background: ${c}`} aria-hidden="true"></span>
            <p class="hs__bt">{t}</p>
            <p class="hs__ba">{a}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
  <p class="libapp__note hs__note" role="status" data-note></p>
</div>

<style>
  /* A phone-shaped screen (375 × 812, as in Figma). On a short window the whole phone shrinks to fit,
     keeping its shape, instead of getting squashed. The page scrolls up and down, each shelf sideways. */
  .hs-frame {
    position: relative;
    width: auto;
    height: max(360px, min(812px, 100dvh - 2 * var(--layout-margin) - var(--layout-control-size) - var(--layout-card-padding), (100vw - 2 * var(--layout-margin)) * 812 / 375));
    aspect-ratio: 375 / 812;
    max-width: 100%;
    overflow: hidden;
  }
  /* The screen itself is always laid out at phone size, then scaled to fit the frame */
  .hs {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 375px;
    height: 812px;
    transform: scale(var(--hs-scale, 1));
    transform-origin: 0 0;
    padding-bottom: 24px;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: inherit;
  }
  /* No grey browser scrollbars, as in the app. Scrolling still works by wheel, touch, keyboard and dragging. */
  .hs, .hs__row { scrollbar-width: none; }
  .hs::-webkit-scrollbar, .hs__row::-webkit-scrollbar { display: none; }
  .hs:focus-visible { outline-offset: -4px; }
  .hs__top {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 24px;
    border-bottom: 1px solid var(--lib-line);
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--lib-bg);
  }
  .hs__app { flex: 1; font-size: 24px; font-weight: 700; }
  .hs__tune {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--lib-line);
    border-radius: 8px;
    background: var(--lib-surface);
    cursor: pointer;
  }
  .hs__avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--lib-surface); }
  /* Tooltip under the Tune icon, beside "Start Reading", as in Figma */
  .hs__tip {
    position: absolute;
    top: 62px;
    right: 12px;
    z-index: 1;
    margin: 0 !important;
    background: var(--lib-bg);
    padding: 6px 8px;
    border: 1px solid var(--lib-line);
    border-radius: 8px;
    font-size: 11px;
    color: var(--lib-faint);
  }
  /* The note floats over the bottom of the screen, so it never pushes the layout about */
  .hs__note:empty { display: none; }
  .hs__note {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    z-index: 2;
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--lib-ink);
    color: #ffffff;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
  }
  .hs__title { padding: 12px 24px 0; }
  .hs__shelf { display: flex; flex-direction: column; gap: 8px; }
  .hs__shelf-h { padding-inline: 24px; font-size: 16px; font-weight: 400; line-height: 1.5; color: var(--lib-ink); }
  .hs__row {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0 24px 8px;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 24px; /* snap books to the 24px margin, not the edge */
  }
  .hs__row.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
  @media (pointer: fine) { .hs__row { cursor: grab; } }
  .hs__book { flex: none; width: 96px; scroll-snap-align: start; display: flex; flex-direction: column; gap: 6px; }
  .hs__cover { display: block; height: 128px; border-radius: 8px; }
  .hs__bt { font-size: 14px; font-weight: 600; line-height: 1.45; color: var(--lib-ink); }
  .hs__ba { font-size: 12px; line-height: 1.35; color: var(--lib-text); }
</style>

<script>
  import { notes } from './libapp';
  document.querySelectorAll<HTMLElement>('[data-home]').forEach((root) => {
    notes(root);
    new ResizeObserver(() => {
      if (root.clientHeight) root.style.setProperty('--hs-scale', String(Math.min(root.clientWidth / 375, root.clientHeight / 812)));
    }).observe(root);
    // With scrollbars hidden, a mouse can drag a shelf sideways (touch and trackpads already swipe).
    root.querySelectorAll<HTMLElement>('.hs__row').forEach((row) => {
      let x0 = 0, s0 = 0, down = false;
      row.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        down = true; x0 = e.clientX; s0 = row.scrollLeft;
      });
      row.addEventListener('pointermove', (e) => {
        if (!down) return;
        if (Math.abs(e.clientX - x0) > 3 && !row.classList.contains('is-dragging')) { row.classList.add('is-dragging'); row.setPointerCapture(e.pointerId); }
        if (row.classList.contains('is-dragging')) row.scrollLeft = s0 - (e.clientX - x0);
      });
      const end = () => { down = false; row.classList.remove('is-dragging'); };
      row.addEventListener('pointerup', end);
      row.addEventListener('pointercancel', end);
    });
  });
</script>
