---
// Icons exported from the Figma Components page. They use currentColor so they follow the token colour of their parent.
interface Props {
  name: 'moon' | 'sun' | 'menu' | 'close' | 'arrow-right' | 'arrow-left' | 'arrow-up' | 'enlarge';
  class?: string;
}
const { name, class: className } = Astro.props;
---
{name === 'moon' && (
  <svg class={className} width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
    <path d="M5.57812 1.22363C5.36508 2.02373 5.25 2.86378 5.25 3.73047C5.25 9.11525 9.61522 13.4805 15 13.4805C15.2568 13.4805 15.511 13.468 15.7627 13.4482C14.2714 15.5836 11.7997 16.9805 9 16.9805C4.44365 16.9805 0.75 13.2868 0.75 8.73047C0.75 5.39586 2.72968 2.52385 5.57812 1.22363Z" stroke="currentColor" style="stroke-width: var(--border-icon)" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'sun' && (
  <svg class={className} width="21" height="21" viewBox="0 0 21 21" fill="none" aria-hidden="true" focusable="false">
    <path d="M16.75 10.25H19.75M14.85 14.85L16.97 16.97M10.25 16.75V19.75M5.65 14.85L3.53 16.97M3.75 10.25H0.75M5.65 5.65L3.53 3.53M10.25 3.75V0.75M14.85 5.65L16.97 3.53M14.75 10.75C14.75 12.9591 12.9591 14.75 10.75 14.75C8.54086 14.75 6.75 12.9591 6.75 10.75C6.75 8.54086 8.54086 6.75 10.75 6.75C12.9591 6.75 14.75 8.54086 14.75 10.75Z" stroke="currentColor" style="stroke-width: var(--border-icon)" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'menu' && (
  <svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
    <path d="M3 6H21M3 12H21M3 18H21" stroke="currentColor" style="stroke-width: var(--border-icon)" stroke-linecap="round" />
  </svg>
)}
{name === 'close' && (
  <svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
    <path d="M5 5L19 19M19 5L5 19" stroke="currentColor" style="stroke-width: var(--border-icon)" stroke-linecap="round" />
  </svg>
)}
{(name === 'arrow-right' || name === 'arrow-left' || name === 'arrow-up') && (
  <svg class={className} style={name === 'arrow-up' ? 'transform: rotate(-90deg)' : name === 'arrow-left' ? 'transform: rotate(180deg)' : undefined} width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true" focusable="false">
    <path d="M23.1577 6.0533C23.4506 5.76041 23.4506 5.28553 23.1577 4.99264L18.3848 0.21967C18.0919 -0.0732232 17.617 -0.0732235 17.3241 0.21967C17.0312 0.512563 17.0312 0.987437 17.3241 1.28033L21.5668 5.52297L17.3241 9.76561C17.0312 10.0585 17.0312 10.5334 17.3241 10.8263C17.617 11.1192 18.0919 11.1192 18.3848 10.8263L23.1577 6.0533ZM0 5.52297V6.27297H22.6274V4.77297H0V5.52297Z" fill="currentColor" />
  </svg>
)}
{name === 'enlarge' && (
  <svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
    <path d="M5 19H10V21H3V14H5V19ZM21 21H14V19H19V14H21V21ZM10 5H5V10H3V3H10V5ZM21 10H19V5H14V3H21V10Z" fill="currentColor" />
  </svg>
)}
