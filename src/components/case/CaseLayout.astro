---
// Shared shell for every case study: header, meta, the stacked sections, View all work and Back to top.
import Base from '../../layouts/Base.astro';
import ProjectHeader from './ProjectHeader.astro';
import ProjectMeta from './ProjectMeta.astro';
import ButtonPair from './ButtonPair.astro';
import BackToTop from './BackToTop.astro';
interface Props {
  title: string;
  pageTitle: string;
  description: string;
  next?: string;
  meta: [string, string][];
}
const { title, pageTitle, description, next, meta } = Astro.props;
---
<Base title={pageTitle} description={description} current="work">
  <span id="top"></span>
  <ProjectHeader title={title} next={next} />
  <div class="sections container">
    <ProjectMeta items={meta} />
    <slot />
    <div class="sections__end"><ButtonPair href="/my-work/" label="View all work" /></div>
  </div>
  <BackToTop />
</Base>

<style>
  .sections {
    display: flex;
    flex-direction: column;
    gap: var(--layout-section);
    margin-top: var(--layout-block-gap);
  }
  .sections__end {
    display: flex;
    justify-content: flex-end;
  }
  /* A group: text and its images, spaced by layout/block-gap; images and loose sections sit in the right-hand column */
  .sections :global(.group) {
    display: flex;
    flex-direction: column;
    gap: var(--layout-block-gap);
  }
  /* Right-hand column: 909 wide (layout/content-width), narrowing only when the window is too narrow
     to fit it beside a process card, so text, images, tables and callouts always share one left edge. */
  .sections {
    --right-col: min(var(--layout-content-width), 100% - var(--layout-process-card-width) - var(--layout-gutter));
  }
  @media (min-width: 1280px) {
    .sections :global(.right) {
      align-self: flex-end;
      width: var(--right-col);
    }
  }
</style>
