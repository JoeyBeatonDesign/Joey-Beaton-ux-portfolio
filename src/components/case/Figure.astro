---
// Figma: Image (Size Large / Figure, Stage On) + Lightbox / Lightbox / Figure.
// The image sits on colour/bg/image-accent with layout/block-gap padding. Hover: Elevation/Hover (no enlarge chip: removed at Joey's request).
// Clicking opens a lightbox (modal dialog): focus moves to Close, Esc or a click outside closes it,
// and focus returns to the image. Desktop shows `image`; below 1280px shows `mobile` when given.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';

interface Props {
  id: string;
  image: ImageMetadata;
  mobile?: ImageMetadata;
  lightbox?: ImageMetadata;
  alt: string;
  caption?: string;
  /** fill: picture grows edge to edge on hover. stage: only the stage colour changes (Library screens). */
  hover?: 'fill' | 'stage';
}
const { id, image, mobile, lightbox, alt, caption, hover = 'fill' } = Astro.props;
const desk = await getImage({ src: image, format: 'webp', widths: [909, 1818], width: 1818 });
const mob = mobile ? await getImage({ src: mobile, format: 'webp', widths: [358, 716], width: 716 }) : null;
const big = await getImage({ src: lightbox ?? image, format: 'webp', width: (lightbox ?? image).width });
const dialogId = `lightbox-${id}`;
---
<figure class="fig">
  <button type="button" class="fig__media" data-lightbox-open={dialogId} data-hover={hover} aria-haspopup="dialog">
    <picture>
      {mob && <source media="(max-width: 1279px)" srcset={mob.srcSet.attribute} sizes="100vw" />}
      <img style={`--ar-d: ${image.width} / ${image.height}; --ar-m: ${(mobile ?? image).width} / ${(mobile ?? image).height}`} src={desk.src} srcset={desk.srcSet.attribute} sizes="(min-width: 1280px) 813px, 100vw" alt={alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
    </picture>
    <span class="visually-hidden">Enlarge image</span>
  </button>
  {caption && <figcaption class="fig__caption t-body">{caption}</figcaption>}
</figure>

<dialog id={dialogId} class="lightbox" aria-label={alt}>
  <div class="lightbox__inner">
    <div class="lightbox__controls">
      <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close image"><Icon name="close" /></button>
    </div>
    {Astro.slots.has('live')
      ? <div class="lightbox__live"><slot name="live" /></div>
      : <img class="lightbox__img" src={big.src} alt={alt} width={(lightbox ?? image).width} height={(lightbox ?? image).height} loading="lazy" decoding="async" />}
  </div>
</dialog>

<style>
  .fig {
    display: flex;
    flex-direction: column;
    gap: var(--layout-inline);
    width: 100%;
    max-width: var(--layout-content-width);
    margin: 0;
  }
  .fig__media {
    position: relative;
    display: block;
    width: 100%;
    padding: var(--layout-block-gap);
    border: 0;
    border-radius: var(--radius-card);
    background: var(--colour-bg-image-accent);
    cursor: zoom-in;
    transition: box-shadow 150ms ease-out;
  }
  /* Reserve the right shape before the image loads: mobile image below 1280, desktop image above */
  .fig__media img {
    width: 100%;
    height: auto;
    aspect-ratio: var(--ar-m);
    border-radius: var(--radius-image);
  }
  @media (min-width: 1280px) {
    .fig__media img { aspect-ratio: var(--ar-d); }
  }
  .fig__media:hover,
  .fig__media:focus-visible {
    box-shadow: 0 var(--space-8) var(--space-24) var(--space-0) var(--colour-shadow);
  }
  /* Hover, as in the Figma prototype (Image State=Hover, Stage=Off): the stage colour drops away
     (colour/image/bg). "fill" also grows the picture edge to edge, as a zoom so the page doesn't move. */
  .fig__media {
    overflow: hidden;
    transition: box-shadow 150ms ease-out, background-color 150ms ease-out;
  }
  .fig__media img {
    transition: transform 150ms ease-out;
  }
  .fig__media:hover,
  .fig__media:focus-visible {
    background: var(--colour-image-bg);
  }
  .fig__media[data-hover='fill']:hover img,
  .fig__media[data-hover='fill']:focus-visible img {
    transform: scale(var(--fill-scale, 1));
  }
  .fig__media:focus-visible {
    box-shadow:
      0 0 0 calc(var(--border-active) * 2) var(--colour-focus-ring-outer),
      0 var(--space-8) var(--space-24) var(--space-0) var(--colour-shadow);
  }
  .fig__caption { color: var(--colour-text-body); }

  /* Lightbox: open 200ms fade, close instant */
  .lightbox {
    width: 100%;
    max-width: calc(1376px + 2 * var(--layout-margin));
    max-height: 100%;
    margin: auto;
    padding: var(--layout-margin);
    border: 0;
    background: transparent;
    overflow: auto;
  }
  .lightbox[open] { animation: lb-fade 200ms ease-out; }
  .lightbox::backdrop { background: var(--colour-overlay-scrim); }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  .lightbox__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--layout-card-padding);
  }
  .lightbox__controls {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }
  .lightbox__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--layout-control-size);
    height: var(--layout-control-size);
    padding: var(--layout-stack);
    border: var(--border-default) solid var(--colour-action-outline);
    border-radius: var(--radius-button);
    background: var(--colour-bg-page);
    color: var(--colour-action-outline);
    cursor: pointer;
  }
  .lightbox__live {
    display: flex;
    justify-content: center;
    width: 100%;
  }
  .lightbox__img {
    width: auto;
    max-width: 100%;
    height: auto;
  }
  @media (min-width: 1280px) {
    /* Up to 880 tall (Figma Lightbox / Figure), and never taller than the screen leaves room for */
    .lightbox__img { max-height: min(880px, calc(100dvh - 2 * var(--layout-margin) - var(--layout-control-size) - var(--layout-card-padding))); }
  }
</style>

<script>
  // Hover "fill": work out how much the picture must grow to reach the box edges (box width ÷ picture width).
  const setFill = () => document.querySelectorAll<HTMLElement>('.fig__media[data-hover="fill"]').forEach((box) => {
    const img = box.querySelector('img');
    if (img && img.offsetWidth) box.style.setProperty('--fill-scale', String(box.clientWidth / img.offsetWidth));
  });
  setFill();
  window.addEventListener('resize', setFill);
  window.addEventListener('load', setFill);

  // One handler for every lightbox on the page.
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach((opener) => {
    const dialog = document.getElementById(opener.dataset.lightboxOpen!) as HTMLDialogElement | null;
    if (!dialog) return;
    opener.addEventListener('click', () => {
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')?.focus();
    });
    dialog.querySelectorAll('[data-lightbox-close]').forEach((b) => b.addEventListener('click', () => dialog.close()));
    // Click on the dark area outside the image (or outside a live app screen) closes it.
    // Both the press and the release must be outside, so dragging a shelf or selecting text never closes it.
    const content = '.lightbox__img, .libapp, .lib, .lightbox__controls';
    const outside = (t: EventTarget | null) => t instanceof Element && !t.closest(content);
    let downOutside = false;
    dialog.addEventListener('pointerdown', (e) => { downOutside = outside(e.target); });
    dialog.addEventListener('click', (e) => {
      if (downOutside && outside(e.target)) dialog.close();
      downOutside = false;
    });
    // Wait a tick: the browser restores its own focus on close, then we move it to the image.
    dialog.addEventListener('close', () => setTimeout(() => opener.focus(), 0));
  });
</script>
