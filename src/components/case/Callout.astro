---
// Figma: Callout (surface card, Label + body), 640 wide inside the right-hand column.
interface Props { label: string }
const { label } = Astro.props;
---
<aside class="callout">
  <p class="callout__label t-label">{label}</p>
  <div class="callout__body t-body"><slot /></div>
</aside>

<style>
  .callout {
    display: flex;
    flex-direction: column;
    gap: var(--layout-inline);
    width: 100%;
    max-width: var(--layout-text-column);
    padding: var(--layout-card-padding);
    border-radius: var(--radius-card);
    background: var(--colour-bg-surface);
  }
  .callout__label,
  .callout__body {
    color: var(--colour-text-body);
  }
</style>
